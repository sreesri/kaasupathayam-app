# Local development only. Deployed builds get these from EAS environment variables (APK and
# OTA updates) and Render environment variables (website); see README "Deployment".

# Backend base URL. On a physical device use your machine's LAN IP, e.g. http://192.168.1.10:8000
EXPO_PUBLIC_API_URL=http://localhost:8000
# Google OAuth *web* client ID (used by the website, and by Android as the token audience).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxx-web.apps.googleusercontent.com
